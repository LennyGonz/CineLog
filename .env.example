# App
ENV=local
DEBUG=true

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cinelog
POSTGRES_USER=app
POSTGRES_PASSWORD=app

DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/cinelog

# Supabase migration connection (Direct connection, for schema/data import).
# SUPABASE_DATABASE_URL="postgresql://postgres:<YOUR_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# Optional local source connection for Makefile imports (defaults to POSTGRES_* if unset).
# LOCAL_DATABASE_URL="postgresql://app:app@localhost:5432/cinelog"

# Supabase Auth (JWT verification)
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_JWT_AUD="authenticated"
# SUPABASE_ANON_KEY="<your-anon-public-key>"
# Optional for local/dev when using a symmetric JWT secret:
# SUPABASE_JWT_SECRET="<your-jwt-secret>"
# Optional override for JWKS endpoint:
# SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# TMDB
TMDB_READ_ACCESS_TOKEN=your_tmdb_token_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=en-US
